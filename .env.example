# 运行模式: simulation | live
SUPPORTFLOW_RUNTIME_MODE=simulation

# 大模型配置 (兼容 OpenAI 接口协议，可接 DeepSeek / Qwen / OpenAI)
SUPPORTFLOW_LLM_API_KEY=your-api-key-here
SUPPORTFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
SUPPORTFLOW_LLM_MODEL=deepseek-chat
SUPPORTFLOW_LLM_TEMPERATURE=0.0
SUPPORTFLOW_LLM_TIMEOUT_S=30.0

# Embedding 配置 (支持本地 BGE-M3 或兼容 OpenAI 接口的远程服务)
SUPPORTFLOW_EMBEDDING_BACKEND=sentence_transformers
SUPPORTFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SUPPORTFLOW_EMBEDDING_DIM=1024
SUPPORTFLOW_EMBEDDING_API_BASE=
SUPPORTFLOW_EMBEDDING_API_KEY=

# PostgreSQL 配置 (用于 Checkpointer、pgvector 向量存储及幂等工单表)
SUPPORTFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supportflow
SUPPORTFLOW_DB_POOL_MIN_SIZE=2
SUPPORTFLOW_DB_POOL_MAX_SIZE=10
SUPPORTFLOW_DB_STATEMENT_TIMEOUT_MS=5000

# 调查预算与超时配置
SUPPORTFLOW_DEFAULT_MAX_ROUNDS=3
SUPPORTFLOW_DEFAULT_MAX_TOOL_ATTEMPTS=8
SUPPORTFLOW_DEFAULT_MAX_INVESTIGATION_MS=45000
SUPPORTFLOW_DEFAULT_MAX_AGENT_STEPS_PER_TASK=6
SUPPORTFLOW_DEFAULT_ROUND_TIMEOUT_MS=20000
SUPPORTFLOW_DEFAULT_TASK_TIMEOUT_MS=18000
SUPPORTFLOW_DEFAULT_TOOL_TIMEOUT_MS=5000

# 上下文治理阈值
SUPPORTFLOW_MAX_TOOL_OUTPUT_CHARS=1500
SUPPORTFLOW_MAX_MAIN_HISTORY_MESSAGES=12
